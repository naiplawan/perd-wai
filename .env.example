# Server-side OpenRouter credentials for the optional AI explanation.
OPENROUTER_API_KEY=

# Prefer a pinned model with a :free variant for reproducible evaluations.
# Leave unset to use OpenRouter's free router for quick prototyping.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Perd Wai
